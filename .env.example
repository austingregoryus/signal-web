# =============================================================================
# Signal Web — environment configuration
# Copy to `.env` and fill in. See DEPLOY.md for the full production guide.
# =============================================================================

# ---- REQUIRED ----

# The Signal phone number the server links to (E.164).
SIGNAL_NUMBER=+15551234567

# Encryption key for the SQLCipher message store. GENERATE A STRONG RANDOM KEY
# and KEEP IT STABLE — if it changes, the existing encrypted DB cannot be opened.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DB_KEY=

# ---- NETWORK / IDENTITY ----

# Internal URL of the signal-cli-rest-api container (leave as-is for compose).
SIGNAL_API_URL=http://signal-cli-rest-api:8080

# Port the web app listens on INSIDE the container (compose maps host:container).
PORT=8090

# Name shown for this linked device in the phone's Linked Devices list.
DEVICE_NAME=signal-web

# Optional: the account's own Signal UUID. If reactions/receipts on your OWN
# sent messages don't appear, set this (find it via `signal-cli -a <number> listAccounts`).
SIGNAL_SELF_UUID=

# ---- PRODUCTION (set these when deploying; see DEPLOY.md) ----

# The PUBLIC https URL users hit (behind Cloudflare Tunnel / your reverse proxy).
# Used for cookie scope, WebAuthn, and the live-WS origin check. MUST match the
# external hostname exactly. For a local-only docker compose setup use
# http://localhost:8190 (the host-published port) — the default
# http://localhost:8090 makes the live WebSocket reject the browser's origin.
# PUBLIC_URL=https://signal.example.com

# Origins allowed to open the live WebSocket (comma-separated). For production,
# set to your PUBLIC_URL. Include the Vite dev server (:5173) only for local dev.
# ALLOWED_ORIGIN=https://signal.example.com

# WebAuthn Relying Party id (defaults to the PUBLIC_URL hostname). Must be the
# registrable domain (e.g. example.com) for passkeys to work across subdomains.
# RP_ID=example.com

# Set to true behind HTTPS so session cookies carry the Secure flag.
# Defaults to true; only set false for local http testing.
SECURE_COOKIES=true

# Which proxy addresses may report the client IP via X-Forwarded-For (used for
# per-IP login rate limiting). Leave UNSET for the default
# "loopback,uniquelocal": the cloudflared sidecar talks to the app over the
# private Docker network, so it is trusted, while public addresses never are.
# You may instead give an IP/CIDR list, e.g. TRUST_PROXY=172.16.0.0/12.
# Hop counts (TRUST_PROXY=1) are NOT supported — Fastify dropped them, and the
# app refuses to start with one. Do NOT set `true`: that trusts the entire
# X-Forwarded-For chain and lets clients spoof their IP to bypass the rate
# limiter. Set `false` only if exposing the app with no proxy at all.
# TRUST_PROXY=

# ---- LINKING (one-time bootstrap; disable in production) ----

# Bootstrap linking page at /link (shows the QR in the browser). Set to false in
# production once the device is linked. While true AND no password is set, the
# startup log prints a one-time /link?t=TOKEN URL. Once a password is set, /link
# requires an admin session.
ENABLE_LINK_PAGE=false

# The bootstrap token gating /link before a password exists. If unset, a random
# one is generated per boot (and never printed in full). Set this to a value you
# choose so you can construct the /link?t=... URL yourself during setup.
# LINK_BOOTSTRAP_TOKEN=

# ---- OPTIONAL TUNING ----

# Session lifetime / idle timeout (days).
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7

# Where attachment blobs live (relative to the app working dir).
ATTACHMENT_DIR=./data/attachments

# Path to the built frontend (relative to the app working dir).
WEB_DIR=./web/dist
