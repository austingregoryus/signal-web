# The Signal phone number the server links to (E.164).
SIGNAL_NUMBER=+15551234567
# Internal URL of the signal-cli-rest-api container.
SIGNAL_API_URL=http://signal-cli-rest-api:8080
# Port the web app listens on.
PORT=8090
# Name shown for this linked device in the phone's Linked Devices list.
DEVICE_NAME=signal-web
# Optional: the account's own Signal UUID. If reactions/receipts on your OWN sent
# messages don't appear, set this (find it via `signal-cli -a <number> listAccounts`).
SIGNAL_SELF_UUID=

# Bootstrap linking page at /link (shows the QR in the browser). Set to false in
# production once the device is linked.
ENABLE_LINK_PAGE=true
