{
  "name": "signal-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "link-device": "tsx src/signal/link.ts",
    "set-password": "tsx src/setPassword.ts",
    "build:web": "npm --prefix web install && npm --prefix web run build"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "@node-rs/argon2": "^2.0.2",
    "@simplewebauthn/server": "^13.3.2",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "fastify": "^5.2.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
