{
  "name": "signal-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "link-device": "tsx src/signal/link.ts",
    "set-password": "tsx src/setPassword.ts",
    "reset-security-keys": "tsx src/resetSecurityKeys.ts",
    "build:web": "npm --prefix web install && npm --prefix web run build"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.6",
    "@node-rs/argon2": "^2.2.2",
    "@simplewebauthn/server": "^14.0.3",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "fastify": "^5.12.7",
    "tsx": "^4.23.15",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@fastify/static": {
      "glob": "^14.0.3"
    }
  }
}
